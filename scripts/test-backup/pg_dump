#!/bin/sh
# A stand-in for pg_dump, for A80 only (scripts/a80.sh, deploy/test/backup.yaml).
# It runs the real one, then does what the files in /test-control ask:
#   hold      waits until the file goes, with the script still waiting for the
#             dump to finish, and says so in held
#   truncate  cuts the output in half, so the restore fails
#   no-data   leaves one table's rows out, so the counts differ
real=$(ls -d /usr/lib/postgresql/*/bin | tail -n 1)/pg_dump
ctl=/test-control
extra=""
[ ! -e "$ctl/no-data" ] || extra="--exclude-table-data=goose_db_version"
"$real" $extra "$@" || exit $?
out=""
prev=""
for arg; do
	[ "$prev" != -f ] || out=$arg
	prev=$arg
done
if [ -e "$ctl/truncate" ]; then
	truncate -s $(($(wc -c <"$out") / 2)) "$out"
fi
if [ -e "$ctl/hold" ]; then
	touch "$ctl/held"
	while [ -e "$ctl/hold" ]; do sleep 0.2; done
	rm -f "$ctl/held"
fi
