#!/bin/sh
# A stand-in for the GitHub CLI's `gh attestation verify`, for A90 only
# (scripts/a90.sh), with test-releases standing in for GitHub: a locally built
# release has no real attestation. It passes only for this repository, from
# main, when the bundle names the subject's digest, as test-releases gives
# for the digests the test says are attested. The real CLI's check of a real
# release is A90's last step (auto-upgrade.sh verify).
[ "$1 $2" = "attestation verify" ] || exit 4
subject=$3
shift 3
repo="" bundle="" ref=""
while [ $# -gt 0 ]; do
	case $1 in
	--repo) repo=$2 && shift 2 ;;
	--bundle) bundle=$2 && shift 2 ;;
	--source-ref) ref=$2 && shift 2 ;;
	*) shift ;;
	esac
done
[ "$repo" = RIKIKU/PagerArchive ] && [ "$ref" = refs/heads/main ] && [ -s "$bundle" ] || exit 1
case $subject in
oci://*@sha256:*) digest=sha256:${subject##*@sha256:} ;;
*) digest=sha256:$(sha256sum "$subject" | cut -d' ' -f1) ;;
esac
grep -q "\"$digest\"" "$bundle"
