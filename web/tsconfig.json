{
	"extends": "$app/tsconfig",
	"include": ["src", "tests", "*"],
	"exclude": ["src/service-worker"],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		"skipLibCheck": true,
		"sourceMap": true,
		// ArchiveUx is JavaScript with JSDoc types: read them.
		"maxNodeModuleJsDepth": 2
	}
}
