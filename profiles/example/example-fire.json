{
  "$schema": "../../schemas/agency-profile.schema.json",
  "_comment": "Agency profile 'Example Fire' for the made-up example network (SPEC.md section 10).",
  "kind": "agency",
  "name": "example-fire",
  "description": "Example Fire Service",
  "formats": [
    {
      "name": "emergency",
      "_comment": "<job> <type> <description> @ <address>, <locality> [ALARM <digit>] [GRID <6 digits>] [UNITS <appliance> ...] #<group>",
      "priorities": ["Emergency"],
      "match": "^(?P<job_number>EX[0-9]{7}) (?P<event_type>[A-Z]+[0-9]) (?P<description>.+?) @ (?P<address>.+?), (?P<locality>[A-Z][A-Z ]*?)(?: ALARM (?P<alarm_level>[1-9]))?(?: GRID (?P<grid_ref>[0-9]{6}))?(?: UNITS (?P<units>[^#]+?))? #(?P<group>\\S+)$",
      "fields": {
        "units": { "split": " " }
      }
    },
    {
      "name": "follow-up",
      "_comment": "RE <job> <free text> #<group>",
      "priorities": ["Non-emergency"],
      "match": "^RE (?P<job_number>EX[0-9]{7}) .*#(?P<group>\\S+)$"
    },
    {
      "name": "freeform",
      "_comment": "Text-only format: matches anything, extracts nothing.",
      "priorities": ["Admin", "Non-emergency"],
      "match": ""
    }
  ],
  "large_event_fields": [
    {
      "_comment": "A made-up alarm level: ALARM 3 and above means something big (R87).",
      "field": "alarm_level",
      "values": ["3", "4", "5", "6", "7", "8", "9"]
    }
  ],
  "labels": {
    "event_type": {
      "HSF1": "House fire",
      "GRS3": "Grass fire",
      "MED1": "Medical assistance"
    }
  }
}
