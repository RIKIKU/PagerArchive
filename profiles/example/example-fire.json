{
  "$schema": "../../schemas/agency-profile.schema.json",
  "_comment": "Agency profile 'Example Fire' for the made-up example network (SPEC.md section 10).",
  "kind": "agency",
  "name": "example-fire",
  "description": "Example Fire Service",
  "formats": [
    {
      "name": "emergency",
      "_comment": "<job> <type> <description> @ <address>, <locality> [ALARM <digit>] [GRID <6 digits>] [UNITS <appliance> ...] #<call_sign>",
      "priorities": ["Emergency"],
      "match": "^(?P<job_number>EX[0-9]{7}) (?P<event_type>[A-Z]+[0-9]) (?P<description>.+?) @ (?P<address>.+?), (?P<locality>[A-Z][A-Z ]*?)(?: ALARM (?P<alarm_level>[1-9]))?(?: GRID (?P<grid_ref>[0-9]{6}))?(?: UNITS (?P<units>[^#]+?))? #(?P<call_sign>\\S+)$",
      "fields": {
        "units": { "split": " " }
      }
    },
    {
      "name": "follow-up",
      "_comment": "RE <job> <free text> #<call_sign>",
      "priorities": ["Non-emergency"],
      "match": "^RE (?P<job_number>EX[0-9]{7}) .*#(?P<call_sign>\\S+)$"
    },
    {
      "name": "freeform",
      "_comment": "Text-only format: matches anything, extracts nothing.",
      "priorities": ["Admin", "Non-emergency"],
      "match": ""
    }
  ],
  "large_event_fields": [
    {
      "_comment": "A made-up alarm level: ALARM 3 and above means something big (R87).",
      "field": "alarm_level",
      "values": ["3", "4", "5", "6", "7", "8", "9"]
    }
  ],
  "levels": [
    {
      "_comment": "The made-up alarm level's order, lowest first: an integration can send pages at or above one (R49a). Shown only in the integration form.",
      "field": "alarm_level",
      "label": "Alarm level",
      "values": [
        { "value": "1", "label": "First alarm" },
        { "value": "2", "label": "Second alarm" },
        { "value": "3", "label": "Third alarm" },
        { "value": "4", "label": "Fourth alarm" },
        { "value": "5", "label": "Fifth alarm" },
        { "value": "6", "label": "Sixth alarm" },
        { "value": "7", "label": "Seventh alarm" },
        { "value": "8", "label": "Eighth alarm" },
        { "value": "9", "label": "Ninth alarm" }
      ]
    }
  ],
  "labels": {
    "event_type": {
      "HSF1": "House fire",
      "GRS3": "Grass fire",
      "MED1": "Medical assistance"
    }
  }
}
