# Never commit private material: real captures, names, phone numbers, health details, or members-only documents
*.PRIVATE.*
*PRIVATE*
# Except the PowerShell module's private functions: source code, in the folder
# docs/powershell-guidelines.md section 10 names Private/. (Git on Windows matches
# *PRIVATE* without regard to case.)
!/powershell/PagerArchive/Private/
.env
*.env
.secrets/

# Browser app build output and dependencies
web/build/*
!web/build/.gitkeep
web/node_modules/
web/.svelte-kit/
web/test-results/
web/playwright-report/
