// What the maintenance workflow (.github/workflows/maintenance.yml) updates,
// and when (SPEC.md R85-R85c, ADR 0022). Renovate reads this; later rules
// override earlier ones.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Nothing from presets: every rule is here.
  extends: [],
  enabledManagers: ["dockerfile", "docker-compose", "gomod", "npm", "github-actions"],
  timezone: "Etc/UTC",
  dependencyDashboard: false,
  prHourlyLimit: 0,
  prConcurrentLimit: 0,
  labels: ["maintenance"],
  // A pull request that waits is the owner's; one that merges on its own is
  // only theirs if it fails (assignAutomerge is off), and the "CI failed"
  // workflow assigns that one (R85c).
  assignees: ["RIKIKU"],
  // Commits through GitHub's API, so they're the app's and verified.
  platformCommit: "enabled",
  // Main's ruleset merges only a branch that's up to date with main, so of two
  // automatic pull requests open at once, the one behind main is rebased.
  rebaseWhen: "behind-base-branch",
  // GitHub merges once every required check passes (ADR 0022).
  platformAutomerge: true,
  automergeType: "pr",
  postUpdateOptions: ["gomodTidy"],
  // An update doesn't touch VERSION: the Release workflow works out a release's
  // version when it cuts one (ADR 0024).
  //
  // A fix for a known vulnerability (GitHub's alerts, and the OSV database's)
  // gets its own pull request at once, whatever the schedule, labelled
  // "security" as well as "maintenance". When it merges, security-release.yml
  // releases main straight away (SPEC.md 12.1).
  vulnerabilityAlerts: {addLabels: ["security"]},
  osvVulnerabilityAlerts: true,
  npm: {rangeStrategy: "bump"},
  // A patch is never held back by a newer minor version: it has its own pull
  // request, which merges on its own where the rules below say so.
  separateMinorPatch: true,
  packageRules: [
    // R85: the base images under our own images, in every FROM, build stages
    // included, pinned by digest. A new digest or patch, daily, is one pull
    // request that merges on its own, in the next release.
    {
      matchManagers: ["dockerfile"],
      matchUpdateTypes: ["digest", "pinDigest", "patch"],
      groupName: "base images",
      group: {branchTopic: "base-images"},
      automerge: true,
      commitBody: "Merges on its own once every check passes (SPEC.md R85c).",
    },
    // R85a: libraries, on the 1st of the month. Every patch in one pull request
    // that merges on its own; everything larger in another that waits. Each
    // waits 3 days after its release first (owner, 2026-11-09), so a broken or
    // withdrawn release has time to be noticed; base images don't. Actions are
    // pinned by digest, so a moved tag is a digest update, in the patch one.
    // Playwright's image in CI goes with the npm package, as their versions
    // must match (ci.yml checks).
    {
      matchManagers: ["gomod", "npm", "github-actions"],
      matchUpdateTypes: ["patch", "digest", "pinDigest"],
      groupName: "libraries patch",
      group: {branchTopic: "libraries-patch"},
      schedule: ["* * 1 * *"],
      minimumReleaseAge: "3 days",
      automerge: true,
      commitBody: "Merges on its own once every check passes (SPEC.md R85c).",
    },
    {
      matchManagers: ["gomod", "npm", "github-actions", "dockerfile"],
      matchUpdateTypes: ["minor", "major"],
      groupName: "libraries and base images minor and major",
      // One pull request for both (without this, majors get their own).
      group: {branchTopic: "libraries-and-base-images-minor-and-major"},
      schedule: ["* * 1 * *"],
      automerge: false,
      commitBody: "Waits for the owner's review (SPEC.md R85a, R85b).",
    },
    {
      matchManagers: ["gomod", "npm", "github-actions"],
      matchUpdateTypes: ["minor", "major"],
      minimumReleaseAge: "3 days",
    },
    {
      matchManagers: ["github-actions"],
      matchDepTypes: ["action"],
      pinDigests: true,
    },
    // Except Playwright: its image has no release dates, so it would wait
    // forever while the npm package moved, and CI needs the two to match.
    {
      matchPackageNames: ["@playwright/test", "mcr.microsoft.com/playwright"],
      minimumReleaseAge: null,
    },
    // Renovate's own image may have no release dates either.
    {
      matchPackageNames: ["ghcr.io/renovatebot/renovate"],
      minimumReleaseAgeBehaviour: "timestamp-optional",
    },
    // The runner images and Node's majors are in the monthly pull request that
    // waits, Node's long-term support (even) versions only (owner, 2026-11-09),
    // in CI and in the Dockerfile's build stage alike.
    {
      matchPackageNames: ["node"],
      allowedVersions: "/^\\d*[02468]([.-]|$)/",
    },
    // R85b: third-party images, the ones a deployment runs (compose.yaml and
    // the monitoring stack) and the ones CI runs, on Mondays, in one pull
    // request for them all (owner, 2026-11-12), apart from Authentik and
    // PostGIS, which each have their own (the next rule), as they're the ones
    // that need the owner's "Upgrade steps" most (R84a). A new minor or major
    // version waits for the owner.
    {
      matchManagers: ["docker-compose", "github-actions"],
      matchDatasources: ["docker"],
      // Playwright's image, and Renovate's own in maintenance.yml, are libraries.
      matchPackageNames: ["!mcr.microsoft.com/playwright", "!ghcr.io/renovatebot/renovate"],
      groupName: "third-party images",
      group: {branchTopic: "third-party-images"},
      minimumReleaseAge: null,
      schedule: ["* * * * 1"],
      automerge: false,
      commitBody: "Waits for the owner's review (SPEC.md R85a, R85b).",
    },
    {
      matchPackageNames: ["ghcr.io/goauthentik/server", "postgis/postgis"],
      groupName: null,
    },
    // R85b: images named by an exact version, which publish nothing that moves
    // within a minor version (ADR 0019): their patches, in one weekly pull
    // request apart from any new minor version, merge on their own (a minor
    // release, as the monitoring stack's compose.yaml changes; owner, 2026-11-09).
    {
      matchManagers: ["docker-compose"],
      matchPackageNames: ["grafana/alloy", "grafana/tempo", "prom/prometheus"],
      matchUpdateTypes: ["patch"],
      groupName: "exact-version images patch",
      group: {branchTopic: "exact-version-images-patch"},
      automerge: true,
      commitBody: "Merges on its own once every check passes (SPEC.md R85c).",
    },
    // Images only the test stack runs (deploy/test) are libraries: no deployment
    // runs them, so they go in the monthly pull requests, not a weekly release
    // of their own (owner, 2026-11-10).
    {
      matchFileNames: ["deploy/test/**"],
      matchUpdateTypes: ["patch"],
      groupName: "libraries patch",
      group: {branchTopic: "libraries-patch"},
      schedule: ["* * 1 * *"],
      minimumReleaseAge: "3 days",
      automerge: true,
      commitBody: "Merges on its own once every check passes (SPEC.md R85c).",
    },
    {
      matchFileNames: ["deploy/test/**"],
      matchUpdateTypes: ["minor", "major"],
      groupName: "libraries and base images minor and major",
      group: {branchTopic: "libraries-and-base-images-minor-and-major"},
      schedule: ["* * 1 * *"],
      minimumReleaseAge: "3 days",
      automerge: false,
      commitBody: "Waits for the owner's review (SPEC.md R85a, R85b).",
    },
    // PostGIS's tag is <PostgreSQL major>-<PostGIS minor>: both parts are minor
    // versions or more, so every update waits.
    {
      matchPackageNames: ["postgis/postgis"],
      versioning: "regex:^(?<major>\\d+)-(?<minor>\\d+)\\.(?<patch>\\d+)$",
      automerge: false,
      commitBody: "Waits for the owner's review (SPEC.md R85a, R85b).",
    },
    // Our own image in compose.yaml is the release's (stamp-version.sh, ADR 0024).
    {
      matchPackageNames: ["ghcr.io/rikiku/pagerarchive", "pagerarchive"],
      enabled: false,
    },
  ],
}
