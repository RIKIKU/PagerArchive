<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>PagerArchive.Connection</Name>
      <ViewSelectedBy>
        <TypeName>PagerArchive.Connection</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader />
          <TableColumnHeader />
          <TableColumnHeader />
          <TableColumnHeader />
          <TableColumnHeader />
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Uri</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Email</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Role</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>SavedIn</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PagerArchive.Template</Name>
      <ViewSelectedBy>
        <TypeName>PagerArchive.Template</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader />
          <TableColumnHeader />
          <TableColumnHeader />
          <TableColumnHeader />
          <TableColumnHeader />
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Agency</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Colour</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>AgencyProfile</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>AliasCount</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PagerArchive.Alias</Name>
      <ViewSelectedBy>
        <TypeName>PagerArchive.Alias</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader />
          <TableColumnHeader />
          <TableColumnHeader />
          <TableColumnHeader />
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Pattern</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Template</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Ignored</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PagerArchive.ImportResult</Name>
      <ViewSelectedBy>
        <TypeName>PagerArchive.ImportResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader />
          <TableColumnHeader />
          <TableColumnHeader />
          <TableColumnHeader />
          <TableColumnHeader><Label>Changes</Label></TableColumnHeader>
          <TableColumnHeader />
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Index</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Result</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Pattern</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.Changes -join '; '</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Applied</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PagerArchive.Message</Name>
      <ViewSelectedBy>
        <TypeName>PagerArchive.Message</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>SentAt</Label></TableColumnHeader>
          <TableColumnHeader />
          <TableColumnHeader><Label>Alias</Label></TableColumnHeader>
          <TableColumnHeader />
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><ScriptBlock>$_.SentAt.LocalDateTime</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Priority</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.Alias) { $_.Alias } else { $_.Capcode }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Text</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <!-- Format-List: what the detail view shows (R35c, R63a). -->
      <Name>PagerArchive.Message</Name>
      <ViewSelectedBy>
        <TypeName>PagerArchive.Message</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><Label>SentAt</Label><ScriptBlock>$_.SentAt.LocalDateTime</ScriptBlock></ListItem>
              <ListItem><PropertyName>Priority</PropertyName></ListItem>
              <ListItem><PropertyName>Alias</PropertyName></ListItem>
              <ListItem><PropertyName>Capcode</PropertyName></ListItem>
              <ListItem><PropertyName>Agency</PropertyName></ListItem>
              <ListItem><PropertyName>Text</PropertyName></ListItem>
              <ListItem><PropertyName>Group</PropertyName></ListItem>
              <ListItem><PropertyName>JobNumber</PropertyName></ListItem>
              <ListItem><PropertyName>EventType</PropertyName></ListItem>
              <ListItem><PropertyName>Category</PropertyName></ListItem>
              <ListItem><PropertyName>Description</PropertyName></ListItem>
              <ListItem><PropertyName>Address</PropertyName></ListItem>
              <ListItem><PropertyName>Locality</PropertyName></ListItem>
              <ListItem><PropertyName>GridRef</PropertyName></ListItem>
              <ListItem><Label>Units</Label><ScriptBlock>$_.Units -join ', '</ScriptBlock></ListItem>
              <ListItem><Label>Fields</Label><ScriptBlock>($_.Fields.PSObject.Properties | ForEach-Object -Process { "$($_.Name): $($_.Value)" }) -join "`n"</ScriptBlock></ListItem>
              <ListItem><Label>Location</Label><ScriptBlock>if ($_.Location) { "$($_.Location.Latitude), $($_.Location.Longitude)$(if ($_.Location.Approximate) { ' (approximate)' }) from $($_.Location.Source)" } else { 'None' }</ScriptBlock></ListItem>
              <ListItem><PropertyName>ParseFailed</PropertyName></ListItem>
              <ListItem><PropertyName>AddressUnsplit</PropertyName></ListItem>
              <ListItem><PropertyName>LocationMismatch</PropertyName></ListItem>
              <ListItem><PropertyName>Heartbeat</PropertyName></ListItem>
              <ListItem><PropertyName>Ignored</PropertyName></ListItem>
              <ListItem><Label>Receptions</Label><ScriptBlock>($_.Receptions | ForEach-Object -Process { "$($_.ReceivedAt.LocalDateTime.ToString())  $($_.Client)" }) -join "`n"</ScriptBlock></ListItem>
              <ListItem><PropertyName>Id</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
  </ViewDefinitions>
</Configuration>
