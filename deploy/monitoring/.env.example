# Settings for the example monitoring stack (docs/monitoring.md).
# Copy to .env and fill in. .env is never committed.

# Grafana's admin password. Grafana shows client and user IDs: give access
# to the deployment's admins only (R76).
GRAFANA_ADMIN_PASSWORD=

# The same value as METRICS_TOKEN in PagerArchive's own .env: Alloy scrapes
# the API's /metrics with it (R75).
PA_METRICS_TOKEN=

# Where Grafana listens. 127.0.0.1 keeps it on this machine; use the
# server's LAN address to reach it from your network. Don't publish it to
# the internet.
GRAFANA_BIND=127.0.0.1:3000
# The address you open Grafana at. The links in alert notifications use it,
# so change it with GRAFANA_BIND (e.g. http://192.168.1.20:3000).
GRAFANA_ROOT_URL=http://localhost:3000

# PagerArchive's compose network and the API's address on it. The defaults
# fit the compose file at the top of the repository.
PAGERARCHIVE_NETWORK=pagerarchive_default
PA_API_ADDRESS=api:8080

# How long Prometheus keeps metrics (traces and logs: 7 days, set in
# tempo/tempo.yaml and loki/loki.yaml).
METRICS_RETENTION=30d

# Only with compose.clients.yaml: the address receiving clients on other
# machines send OTLP to, e.g. 192.168.1.20:4318.
ALLOY_OTLP_BIND=
