# Test-only settings for the compose stack (deploy/test/compose.yaml).
# Made-up secrets for throwaway test stacks; never use them for a deployment.
POSTGRES_PASSWORD=test-postgres
AUTHENTIK_DB_PASSWORD=test-authentik-db
AUTHENTIK_SECRET_KEY=test-secret-key-test-secret-key-test-secret-key-0123456789
AUTHENTIK_ADMIN_EMAIL=akadmin@example.test
AUTHENTIK_ADMIN_PASSWORD=test-akadmin-password
AUTHENTIK_API_TOKEN=test-api-token-0123456789abcdef0123456789abcdef
OIDC_CLIENT_SECRET=test-oidc-client-secret-0123456789abcdef
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_FROM=pagerarchive@example.test
APP_URL=http://localhost:8080
AUTHENTIK_URL=http://localhost:9000
ALLOWED_EMAIL_DOMAINS=example.test
INITIAL_ADMIN_EMAIL=owner@example.test
TZ=Australia/Melbourne
