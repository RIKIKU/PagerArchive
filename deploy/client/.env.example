# A receiving client's settings (docs/client.md, "Settings"). Saved as .env
# beside compose.yaml; the API key goes in the file named key, not here.

# The server's base URL (docs/client.md, "Reaching the server").
SERVER_URL=https://pager.example.test
# The ID the client's key was issued for (pagerarchive client add <id>).
CLIENT_ID=shed-receiver
# The frequency to receive; empty reads multimon-ng's lines on stdin.
RADIO_FREQUENCY=148.8125M
# RADIO_GAIN=
# RADIO_PPM=0
# POCSAG_BAUDS=512,1200,2400
# ALLOW_PLAIN_HTTP=false
# Telemetry to the example monitoring stack's Alloy (docs/monitoring.md).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://monitoring.example.test:4318

# Automatic upgrades (docs/client.md, "Automatic upgrades"): off until
# ./client-auto-upgrade.sh enable. A client is never upgraded past the
# version its server runs.
# AUTO_UPGRADE_HEALTH_WAIT=60
# AUTO_UPGRADE_START_TIMEOUT=300
