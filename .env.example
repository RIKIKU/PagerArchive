# PagerArchive deployment settings. Copy to .env (never commit .env) and fill
# in. Generate each secret with: openssl rand -base64 36 | tr -d '/+='
# See docs/deploy.md.

# Public URLs, behind your own reverse proxy (TLS). Authentik needs its own
# subdomain (SPEC.md R40).
APP_URL=https://pager.example.org
AUTHENTIK_URL=https://auth.example.org

# Who may be invited: addresses at these domains, comma-separated, matched
# exactly (R41).
ALLOWED_EMAIL_DOMAINS=example.org
# May set up the first admin account, without an invitation, while there is
# no admin (R44). Ignored once an admin exists.
INITIAL_ADMIN_EMAIL=you@example.org

# Deployment time zone for dates and times (R35a).
TZ=Australia/Melbourne

# Profiles directory, mounted read-only (default: the example profile).
# PROFILES_DIR=../PagerArchive-profiles/my-network

# Map tiles: a PMTiles extract of your area (docs/deploy.md, "Map"). The
# default is the made-up example map. MAP_ATTRIBUTION overrides the credit
# line stored in the extract.
# MAP_TILES_FILE=/srv/pagerarchive/map.pmtiles
# MAP_ATTRIBUTION=© OpenStreetMap contributors

# Local time of the nightly run that deletes messages past the retention
# period and applies changed redaction rules (R45).
# NIGHTLY_AT=03:00

# Secrets.
POSTGRES_PASSWORD=
AUTHENTIK_DB_PASSWORD=
AUTHENTIK_SECRET_KEY=
# Encrypts integrations' secrets (docs/integrations.md). 32 random bytes:
# openssl rand -base64 32. Without it, integrations are off. While changing
# it, put the previous key in INTEGRATION_SECRETS_KEY_OLD.
INTEGRATION_SECRETS_KEY=
# INTEGRATION_SECRETS_KEY_OLD=
# Bearer token for GET /metrics (Prometheus). Without it, metrics are off.
METRICS_TOKEN=
# Password of the role that counts locked accounts for the metrics.
AUTHENTIK_METRICS_DB_PASSWORD=
# The app's Authentik API token and OIDC client secret: any long random
# strings; Authentik is configured with them on start.
AUTHENTIK_API_TOKEN=
OIDC_CLIENT_SECRET=

# Authentik's own administrator account (username akadmin), for you as the
# deployment's operator. Not a PagerArchive account.
AUTHENTIK_ADMIN_EMAIL=you@example.org
AUTHENTIK_ADMIN_PASSWORD=

# Mail for invitations and codes, sent by Authentik.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM=PagerArchive <pager@example.org>

# Where the containers listen. Keep them on 127.0.0.1 (or a private address)
# and let your reverse proxy reach them.
# API_BIND=127.0.0.1:8080
# AUTHENTIK_BIND=127.0.0.1:9000
